VITE_API_ROOT_DOMAIN=3s-export.com
VITE_API_SCHEME=https
VITE_API_USE_DEV_PROXY=false
VITE_API_DEV_PROXY_TARGET=
VITE_API_PASSWORD=TenantSecret
# Required only by the Facebook sub-login endpoint hosted on the main server.
VITE_MAIN_SERVER_URL=
VITE_REALTIME_ENABLED=false
VITE_REVERB_APP_KEY=your-reverb-app-key
VITE_REVERB_HOST=
VITE_REVERB_ROOT_DOMAIN=3s-export.com
VITE_REVERB_SCHEME=https
VITE_REVERB_PORT=

# Sign-in methods shown as active on /login (password is always on).
# Others need their backend endpoints first: google, face_id, fingerprint
VITE_AUTH_METHODS=password

# Customer Service demo data: auto (mock modules not yet live) | all | none
VITE_SERVICE_MOCKS=auto

# Customer portal (portal.html) router base path; use / when the portal has its own subdomain
VITE_PORTAL_BASENAME=/portal
